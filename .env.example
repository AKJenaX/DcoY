# DcoY - Environment Configuration Template
# Copy this file to '.env' and adjust variables for your local deployment.

# General App configurations
APP_NAME=DcoY
DEBUG=False

# LLM (Ollama) settings
LLM_ENABLED=True
LLM_HOST=http://127.0.0.1:11434
LLM_MODEL=llama3
LLM_TIMEOUT=2.0
LLM_HEALTH_CHECK_INTERVAL=60.0
LLM_RETRY_INTERVAL=30.0
LLM_FAILURE_THRESHOLD=3

# JWT secret key for session tokens (Must be randomized for production!)
SECRET_KEY=generate_a_secure_random_key_here_for_prod_use
ACCESS_TOKEN_EXPIRE_MINUTES=30
