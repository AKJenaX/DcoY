# ==============================================================================
# DcoY Enterprise Security Platform - Production Environment Configuration
# ==============================================================================
# IMPORTANT: Copy this file to '.env' on your production server.
# NEVER commit the filled '.env' file containing actual secrets to version control.
# ==============================================================================

# Application Environment
ENV=production
DEBUG=false
APP_NAME="DcoY Enterprise Security Platform"

# Network & Server Port Settings
HOST=0.0.0.0
PORT=8001

# Security & Secret Key Configuration
# Generate a cryptographically secure 64-character key via: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_A_SUPER_SECURE_64_CHARACTER_RANDOM_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed production domain origins
CORS_ORIGINS=https://dcoy.yourdomain.com,https://console.dcoy.yourdomain.com

# Database Connection (SQLite / PostgreSQL)
# SQLite default: sqlite:///./dcoy.db
# PostgreSQL example: postgresql://dcoy_user:secure_password@postgres:5432/dcoy_prod
DATABASE_URL=sqlite:///./dcoy.db

# Observability & Structured JSON Logging
LOG_LEVEL=INFO
LOG_FORMAT_JSON=true

# AI Copilot & Reasoning Agent Integration
# Set to true if local Ollama or OpenAI LLM endpoint is available
LLM_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
